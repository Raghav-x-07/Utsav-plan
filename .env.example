# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key for GenAI personalized suggestions and plan summary
# Optional: The planner works 100% offline with its deterministic rule engine if this is not provided
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
