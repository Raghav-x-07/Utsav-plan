# Server Configuration
PORT=3000
NODE_ENV=development

# GenAI API Keys (Optional: works 100% offline with deterministic rule engine if unset)
# Provide either a Groq API Key (Llama 3.3) or Google Gemini API Key
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
